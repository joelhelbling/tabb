{
  "manifest_version": 3,
  "name": "tabb",
  "version": "0.1.0",
  "description": "Expose browser tabs to CLI and AI assistants via Native Messaging",
  "permissions": [
    "tabs",
    "scripting",
    "nativeMessaging",
    "contextMenus",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
